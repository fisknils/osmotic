{
	"name": "osmotic",
	"version": "3.0.0",
	"description": "Chainable web scraper for Node.js: find, extract and follow with CSS selectors, respects robots.txt, exports results through plugins such as CSV",
	"license": "ISC",
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fisknils/osmotic.git"
	},
	"homepage": "https://github.com/fisknils/osmotic#readme",
	"bugs": {
		"url": "https://github.com/fisknils/osmotic/issues"
	},
	"type": "commonjs",
	"main": "dist/index.cjs",
	"files": [
		"dist",
		"examples",
		"README.md"
	],
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "npm run clean && tsc",
		"prepublishOnly": "npm run build",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"test": "npm run build && tsc -p tsconfig.test.json && node --import tsx --test \"test/*.ts\"",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"cheerio": "^1.2.0",
		"domhandler": "^5.0.3",
		"robots-parser": "^3.0.1",
		"undici": "^8.12.3"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"prettier": "3.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"types": "dist/index.d.cts"
}
