{
	"name": "osmotic",
	"version": "1.1.0",
	"description": "Chainable web scraper for Node.js: find, extract and follow with CSS selectors, respects robots.txt, streams results to CSV",
	"license": "ISC",
	"author": "",
	"type": "commonjs",
	"main": "dist/index.cjs",
	"files": [
		"dist",
		"examples",
		"README.md"
	],
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "npm run clean && tsc",
		"prepare": "npm run build",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"cheerio": "^1.2.0",
		"domhandler": "^5.0.3",
		"robots-parser": "^3.0.1",
		"undici": "^8.12.3"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"prettier": "3.3.3",
		"typescript": "^7.0.2"
	},
	"types": "dist/index.d.cts"
}
